{
  "name": "barrack",
  "private": true,
  "description": "Open-source, self-hostable, always-on coding-agent platform.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
