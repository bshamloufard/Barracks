{
  "name": "barrack",
  "private": true,
  "description": "Open-source, self-hostable, always-on coding-agent platform.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && node --import tsx scripts/dev/main.ts",
    "build": "pnpm --recursive build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "pnpm build:packages && tsc --project tsconfig.json && pnpm --recursive typecheck",
    "test": "pnpm build:packages && vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "sandbox-image:build": "docker build --file sandbox-image/Dockerfile --tag barrack-sandbox:dev ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
