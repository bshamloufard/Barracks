#!/bin/sh
# Starts the supervisor in the background unless one is already running, so
# it is safe to run any number of times. Providers that do not make the
# supervisor the sandbox's main process (Daytona chooses its own) run this
# after every create and every start. With --check it only reports, through
# its exit status, whether a supervisor is running.
#
# Exit status: 0 when a supervisor is running (or has just been started),
# 3 with --check when none is, 1 on any other failure.
set -eu

pid_file=/run/barrack/supervisor.pid
lock_file=/run/barrack/ensure-supervisor.lock
log_file=/var/log/barrack/supervisor.log

supervisor_is_running() {
  [ -s "$pid_file" ] || return 1
  pid="$(cat "$pid_file")"
  # A recorded ID can outlive its process (the file survives a stop) and be
  # reused by another, so the process must also be the supervisor: running
  # its entry point, as its user. The agent can start a process with any
  # command line, but not as the supervisor's user.
  [ -r "/proc/$pid/cmdline" ] &&
    [ "$(stat -c %U "/proc/$pid")" = "$BARRACK_SUPERVISOR_USER" ] &&
    tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q '/opt/barrack/supervisor/dist/main.js'
}

if [ "${1:-}" = "--check" ]; then
  supervisor_is_running && exit 0
  exit 3
fi

# Two concurrent runs must not both decide that no supervisor is running.
# The lock file is made by the image and only root and the supervisor's user
# may open it, so the agent cannot hold the lock to stop a supervisor from
# being started. Reading is all flock needs.
exec 9< "$lock_file"
flock 9

if supervisor_is_running; then
  exit 0
fi

if [ "$(id -u)" = "0" ]; then
  # Commands a provider runs may arrive as root; the supervisor never runs as root.
  run_as_supervisor="setpriv --reuid=$BARRACK_SUPERVISOR_USER --regid=$BARRACK_SUPERVISOR_USER --init-groups"
else
  run_as_supervisor=""
fi

# setsid detaches the supervisor from the command that started it, so it
# keeps running when that command's session ends. It must not inherit the lock.
# shellcheck disable=SC2086 # $run_as_supervisor is deliberately split into words.
setsid $run_as_supervisor /usr/local/bin/barrack-run-supervisor \
  >> "$log_file" 2>&1 < /dev/null 9<&- &

# Give a supervisor that fails at once (bad configuration, say) time to exit,
# so the failure is reported here rather than discovered later.
sleep 1
if supervisor_is_running; then
  exit 0
fi
# The end of the log says why, usually in the supervisor's own words; the
# provider that ran this shows it to whoever started the sandbox.
echo "The supervisor did not stay running. The end of $log_file:" >&2
tail -n 8 "$log_file" >&2
exit 1
