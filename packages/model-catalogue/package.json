{
  "name": "@barrack/model-catalogue",
  "version": "0.0.0",
  "private": true,
  "description": "The model providers and models the pinned agent supports, generated from it, so the control plane can offer them without running the agent.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "model-catalogue.json"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "generate": "node --import tsx scripts/generate-model-catalogue.ts"
  },
  "dependencies": {
    "@barrack/protocol": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "tsx": "4.23.15"
  }
}
